{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cwapi.task.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "created_at",
    "expires_at",
    "channel_id",
    "target_runner",
    "repository",
    "expected_commit",
    "workspace_mode",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "cwapi.task.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "channel_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "expected_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "workspace_mode": {
      "const": "isolated_worktree"
    },
    "continue_on_failure": {
      "type": "boolean",
      "default": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "action",
          "arguments",
          "timeout_seconds"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "minLength": 1,
            "maxLength": 128
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "arguments": {
            "type": "object"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        }
      }
    }
  }
}
